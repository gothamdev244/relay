{
  "plugins": ["react"],
  "jsPlugins": [{ "name": "relay", "specifier": "./scripts/oxlint-plugin-relay.js" }],
  "rules": {
    "typescript/no-explicit-any": "error",
    "relay/no-vitest-import": "error",
    "relay/no-conditional-tests": "error",
    "relay/no-double-cast": "error",
    "relay/no-cross-package-relative-imports": "error",
    "relay/no-direct-cloud-relay-schema-import": "error",
    "relay/require-reactivity-keys": "error",
    "relay/no-effect-escape-hatch": "error",
    "relay/no-effect-internal-tags": "error",
    "relay/no-error-constructor": "error",
    "relay/no-inline-schema-compile": "error",
    "relay/no-instanceof-error": "error",
    "relay/no-instanceof-tagged-error": "error",
    "relay/no-json-parse": "error",
    "relay/no-manual-tag-check": "error",
    "relay/no-match-orelse": "error",
    "relay/no-promise-catch": "error",
    "relay/no-promise-reject": "error",
    "relay/no-raw-fetch": "error",
    "relay/no-redundant-primitive-cast": "error",
    "relay/no-redundant-error-factory": "error",
    "relay/no-schema-class": "error",
    "relay/no-switch-statement": "error",
    "relay/no-ts-nocheck": "error",
    "relay/no-try-catch-or-throw": "error",
    "relay/no-unknown-error-message": "error",
    "relay/no-unsupported-effect-api": "error",
    "relay/prefer-effect-predicate": "error",
    "relay/prefer-schema-inferred-types": "error",
    "relay/prefer-value-inferred-extension-types": "error",
    "relay/prefer-yield-tagged-error": "error",
    "react/forbid-elements": [
      "error",
      {
        "forbid": [
          { "element": "button", "message": "Use <Button> from @relay-sh/react" },
          { "element": "input", "message": "Use <Input> from @relay-sh/react" },
          { "element": "textarea", "message": "Use <Textarea> from @relay-sh/react" },
          { "element": "select", "message": "Use <Select> or <NativeSelect> from @relay-sh/react" },
          { "element": "table", "message": "Use <Table> from @relay-sh/react" },
          { "element": "label", "message": "Use <Label> from @relay-sh/react" },
        ],
      },
    ],
  },
  "overrides": [
    {
      "files": [
        "apps/cli/src/**/*.{ts,tsx}",
        "apps/desktop/src/main.ts",
        "scripts/**/*.{ts,js}",
        "packages/kernel/runtime-*/src/**/*.{ts,tsx,js,mjs}",
      ],
      "rules": {
        "relay/no-effect-escape-hatch": "off",
        "relay/no-error-constructor": "off",
        "relay/no-instanceof-error": "off",
        "relay/no-json-parse": "off",
        "relay/no-promise-catch": "off",
        "relay/no-promise-reject": "off",
        "relay/no-switch-statement": "off",
        "relay/no-try-catch-or-throw": "off",
        "relay/no-unknown-error-message": "off",
      },
    },
    {
      "files": ["apps/marketing/src/**/*.astro"],
      "rules": {
        "relay/no-effect-escape-hatch": "off",
        "relay/no-error-constructor": "off",
        "relay/no-instanceof-error": "off",
        "relay/no-json-parse": "off",
        "relay/no-try-catch-or-throw": "off",
        "relay/no-unknown-error-message": "off",
      },
    },
    {
      "files": ["packages/core/vite-plugin/src/**/*.{ts,tsx}"],
      "rules": {
        "relay/no-try-catch-or-throw": "off",
      },
    },
    {
      "files": ["packages/kernel/core/src/code-recovery.ts"],
      "rules": {
        "relay/no-switch-statement": "off",
      },
    },
    {
      "files": ["packages/react/src/components/**/*.{ts,tsx}"],
      "rules": {
        "relay/no-error-constructor": "off",
        "relay/no-try-catch-or-throw": "off",
      },
    },
    {
      "files": ["packages/plugins/workos-vault/src/**/*.{ts,tsx}"],
      "rules": {
        "relay/no-inline-object-type-assertion": "error",
        "relay/no-instanceof-tagged-error": "error",
        "relay/no-manual-tag-check": "error",
        "relay/no-promise-client-surface": "error",
        "relay/no-raw-error-throw": "error",
        "relay/no-redundant-error-factory": "error",
        "relay/no-unknown-shape-probing": "error",
      },
    },
  ],
  "ignorePatterns": [
    ".astro/",
    ".reference/",
    ".references/",
    ".turbo/",
    ".worktrees/",
    "dist/",
    "integrationsdotsh/",
    "node_modules/",
    "packages/core/fumadb/",
    "packages/core/sdk/src/vendor/json-schema-to-typescript/",
    "bun.lock",
    "*.tsbuildinfo",
    "relay-*.tgz",
    "**/routeTree.gen.ts",
  ],
}
